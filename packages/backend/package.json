{
  "name": "@saas-autopublisher/backend",
  "version": "1.0.0",
  "description": "Backend REST/SSE API, Metadata Scraper & Enrichment Engine, and Directory Registry Service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive:true,force:true});\"",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "test": "node --experimental-strip-types --test src/__tests__/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.0.2",
    "@saas-autopublisher/shared": "*",
    "@supabase/supabase-js": "^2.49.1",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3"
  }
}
