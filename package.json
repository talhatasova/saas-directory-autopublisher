{
  "name": "saas-directory-autopublisher",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack SaaS Directory Auto-Publisher platform",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start:backend",
    "start:backend": "npm start --workspace=@saas-autopublisher/backend",
    "start:frontend": "npm start --workspace=@saas-autopublisher/frontend",
    "start:worker": "npm start --workspace=@saas-autopublisher/worker",
    "dev:backend": "npm run dev --workspace=@saas-autopublisher/backend",
    "dev:frontend": "npm start --workspace=@saas-autopublisher/frontend",
    "test": "node --experimental-strip-types --import ./tests/setup.ts --test tests/unit/*.spec.ts tests/sandbox/*.spec.ts tests/stress/*.spec.ts",
    "test:unit": "node --experimental-strip-types --import ./tests/setup.ts --test tests/unit/*.spec.ts",
    "test:backend": "npm test --workspace=@saas-autopublisher/backend",
    "test:worker": "npm test --workspace=@saas-autopublisher/worker",
    "test:packages": "npm test --workspaces --if-present",
    "test:sandbox": "node --experimental-strip-types --import ./tests/setup.ts --test tests/sandbox/*.spec.ts",
    "test:stress": "node --experimental-strip-types --import ./tests/setup.ts --test tests/stress/*.spec.ts",
    "test:stress:run": "node --experimental-strip-types tests/stress/stress-load-runner.ts",
    "test:e2e": "npx playwright test --config=tests/e2e/playwright.config.ts",
    "test:all": "npm run test && npm run test:packages && npm run test:stress:run",
    "sandbox:server": "node --experimental-strip-types tests/sandbox/mock-directory-server.ts",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "keywords": [
    "saas",
    "directory-publisher",
    "automation",
    "supabase",
    "angular",
    "playwright"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
